{
  "output_dir": "outputs/train/hilserl_so101",
  "job_name": "hilserl_so101",
  "seed": 42,
  "batch_size": 32,
  "log_freq": 100,
  "save_freq": 1000,
  "save_checkpoint": true,
  "wandb": {
    "enable": false,
    "disable_artifact": true,
    "project": "hilserl_so101"
  },
  "env": {
    "type": "gym_manipulator",
    "name": "real_robot",
    "fps": 30,
    "features": {
      "action": {
        "type": "ACTION",
        "shape": [3]
      }
    },
    "features_map": {
      "action": "action"
    },
    "robot": {
      "type": "so101_follower",
      "id": "kuttler_soarm",
      "port": "/dev/ttyACM0",
      "use_degrees": true,
      "max_relative_target": 15.0,
      "cameras": {
        "front": {
          "type": "opencv",
          "index_or_path": 0,
          "width": 640,
          "height": 480,
          "fps": 30,
          "fourcc": "YUYV",
          "color_mode": "rgb"
        },
        "side": {
          "type": "opencv",
          "index_or_path": 2,
          "width": 640,
          "height": 480,
          "fps": 30,
          "fourcc": "YUYV",
          "color_mode": "rgb"
        }
      }
    },
    "teleop": {
      "type": "spacemouse_soarm_hil",
      "deadzone": 0.02,
      "input_timeout_s": 0.08,
      "read_drain_count": 32
    },
    "processor": {
      "control_mode": "spacemouse_soarm_hil",
      "observation": {
        "display_cameras": true
      },
      "image_preprocessing": {
        "crop_params_dict": {
          "observation.images.front": [32, 16, 85, 88],
          "observation.images.side": [19, 21, 60, 55]
        },
        "resize_size": [128, 128]
      },
      "gripper": {
        "use_gripper": false,
        "gripper_penalty": 0.0
      },
      "reset": {
        "fixed_reset_joint_positions": [-5.407, -40.088, 50.462, 83.385, -85.495, 5.801],
        "reset_time_s": 8.0,
        "control_time_s": 15.0,
        "terminate_on_success": true,
        "reset_lift_offset_z": 0.02,
        "reset_lift_frozen_joints": ["wrist_flex"]
      },
      "inverse_kinematics": {
        "urdf_path": "src/lerobot/teleoperators/spacemouse/urdfs/so101_new_calib.urdf",
        "target_frame_name": "gripper_frame_link",
        "end_effector_step_sizes": {
          "x": 0.002,
          "y": 0.002,
          "z": 0.002
        },
        "end_effector_bounds": {
          "min": [-0.22, -0.4, -0.15],
          "max": [0.4, 0.4, 0.31]
        }
      },
      "reward_classifier": null,
      "max_gripper_pos": 100.0
    }
  },
  "policy": {
    "type": "gaussian_actor",
    "device": "cuda",
    "storage_device": "cpu",
    "push_to_hub": false,
    "input_features": {
      "observation.images.front": {
        "type": "VISUAL",
        "shape": [3, 128, 128]
      },
      "observation.images.side": {
        "type": "VISUAL",
        "shape": [3, 128, 128]
      },
      "observation.state": {
        "type": "STATE",
        "shape": [6]
      }
    },
    "output_features": {
      "action": {
        "type": "ACTION",
        "shape": [3]
      }
    },
    "dataset_stats": {
      "observation.images.front": {
        "mean": [0.485, 0.456, 0.406],
        "std": [0.229, 0.224, 0.225]
      },
      "observation.images.side": {
        "mean": [0.485, 0.456, 0.406],
        "std": [0.229, 0.224, 0.225]
      },
      "observation.state": {
        "min": [-180.0, -180.0, -180.0, -180.0, -180.0, 0.0],
        "max": [180.0, 180.0, 180.0, 180.0, 180.0, 100.0]
      },
      "action": {
        "min": [-1.0, -1.0, -1.0],
        "max": [1.0, 1.0, 1.0]
      }
    },
    "vision_encoder_name": "lerobot/resnet10",
    "freeze_vision_encoder": false,
    "online_steps": 100000,
    "online_buffer_capacity": 12000,
    "offline_buffer_capacity": 3200,
    "online_step_before_learning": 100,
    "actor_learner_config": {
      "learner_host": "127.0.0.1",
      "learner_port": 50051,
      "policy_parameters_push_frequency": 4,
      "queue_get_timeout": 2.0
    },
    "concurrency": {
      "actor": "threads",
      "learner": "threads",
      "multiprocessing_context": "spawn"
    }
  },
  "algorithm": {
    "type": "sac",
    "actor_lr": 0.0003,
    "critic_lr": 0.0003,
    "temperature_lr": 0.0003,
    "discount": 0.99,
    "use_backup_entropy": true,
    "critic_target_update_weight": 0.005,
    "num_critics": 2,
    "num_subsample_critics": null,
    "critic_network_kwargs": {
      "hidden_dims": [256, 256],
      "activate_final": true,
      "final_activation": null
    },
    "discrete_critic_network_kwargs": {
      "hidden_dims": [256, 256],
      "activate_final": true,
      "final_activation": null
    },
    "temperature_init": 1.0,
    "target_entropy": null,
    "utd_ratio": 4,
    "policy_update_freq": 1,
    "grad_clip_norm": 40.0,
    "use_torch_compile": false
  },
  "dataset": {
    "repo_id": "tmy/so101_task_cropped_resized",
    "root": null
  },
  "mixer": "online_offline",
  "online_ratio": 0.5
}
